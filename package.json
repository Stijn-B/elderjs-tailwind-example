{
  "name": "elderjs-template",
  "version": "1.3.4",
  "description": "This is a project template for [Elder.js](https://elderguide.com/tech/elderjs/) apps. The template lives at https://github.com/elderjs/template and the Elder.js source is here: https://github.com/elderjs/elderjs",
  "main": "./src/build.js",
  "scripts": {
    "start": "npm run dev",
    "clean": "node ./src/cleanPublic.js",
    "build": "run-s clean build:html build:tailwind",
    "build:html": "NODE_ENV=production node ./src/build.js",
    "build:tailwind": "tailwindcss -c ./tailwind.config.js -i ./src/tailwind.css -o ./public/tailwind.css --minify  --postcss ./postcss.config.cjs ",
    "dev": "run-p watch:server watch:tailwind",
    "watch:tailwind": "tailwindcss -c ./tailwind.config.js -i ./src/tailwind.css -o ./public/tailwind.css --postcss ./postcss.config.cjs  --watch",
    "serve": "npm run build && NODE_ENV=production node ./src/server.js",
    "eslint": "eslint --ext .js .",
    "eslint:fix": "eslint --fix --ext .js .",
    "prettier:svelte": "prettier --write --plugin-search-dir=. ./**/*.svelte",
    "watch:server": "NODE_ENV=development node ./src/server.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@elderjs/elderjs": "1.8.0-beta.14",
    "@elderjs/plugin-markdown": "1.8.0-beta.7",
    "@elderjs/plugin-seo-check": "^1.3.10",
    "body-parser": "^1.20.9",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "del": "^6.1.1",
    "dotenv": "^8.6.0",
    "fs-extra": "^9.1.0",
    "glob": "^7.2.3",
    "intersection-observer": "^0.12.2",
    "polka": "^0.5.2",
    "sirv": "^1.0.19",
    "svelte": "^3.59.2",
    "svelte-preprocess": "^4.10.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-prettier": "^3.4.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.33",
    "prettier": "^2.8.8",
    "prettier-plugin-svelte": "^2.10.1",
    "tailwindcss": "^3.4.19"
  },
  "author": "Nick Reese",
  "license": "MIT",
  "files": [
    "index.js",
    "elderjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elderjs/template.git"
  },
  "keywords": [
    "svelte",
    "elderjs",
    "ssr",
    "static",
    "site",
    "generator",
    "seo",
    "ssg",
    "template",
    "partial",
    "hydration"
  ],
  "bugs": {
    "url": "https://github.com/Elderjs/template/issues"
  },
  "homepage": "https://github.com/Elderjs/template#readme",
  "overrides": {
    "@elderjs/plugin-markdown": {
      "yaml": "1.10.3"
    },
    "@elderjs/plugin-seo-check": {
      "cheerio": "1.0.0-rc.12",
      "@nickreese/seo-lint": {
        "cheerio": "1.0.0-rc.12"
      }
    }
  }
}
